  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Dorsal Fin
  description: 'A single long fin running along the top of the back, with a spiny
    front section and a soft-rayed rear section, with no notch between them. Function:
    Provides stability and helps prevent the fish from rolling side to side while
    swimming; the spines also offer some defense against predators.'
  titleFontSize: 45
  descriptionFontSize: 24
