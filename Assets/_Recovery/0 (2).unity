  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d393fe7be3c525143b8ecb4051bdff2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Genital Papilla (Urogenital Opening)
  description: "A small papilla located just behind the anus, used to distinguish
    sex in mature tilapia. In males, it appears as a single, pointed, finger-like
    opening used for both waste and sperm release. In females, it appears as two
    separate, smaller, rounder openings \u2014 the anus and a distinct genital opening
    used for egg-laying. Function: Serves as the opening for waste elimination and
    reproduction (release of eggs or milt)."
  titleFontSize: 40
  descriptionFontSize: 23
