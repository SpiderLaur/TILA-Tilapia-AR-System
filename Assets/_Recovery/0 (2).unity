  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d393fe7be3c525143b8ecb4051bdff2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Operculum (Gill Cover)
  description: "A hard, bony flap covering the gill chamber on each side of the head.
    The gills themselves sit underneath and are only visible if the operculum is
    lifted, so they are described here rather than as their own tap zone. Function:
    Protects the feathery, blood-rich gills underneath and helps pump water over
    them by opening and closing rhythmically. The gills extract dissolved oxygen
    from the water and release carbon dioxide \u2014 the fish's primary respiratory
    organ."
  titleFontSize: 42
  descriptionFontSize: 21
