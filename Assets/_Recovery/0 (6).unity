  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Key Features</b>


    Interactive 3D tilapia anatomy models across
    three modes: External, Skeletal, and Internal

    Real-time manipulation of
    3D models (rotate and zoom)

    Tap-to-reveal body part information with voice
    narration

    Marker-based AR accessible on mobile devices

    Curriculum-ready
    for fisheries and marine science classroom use'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
