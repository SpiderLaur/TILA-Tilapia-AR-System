      m_Calls: []
  m_text: '      <b>TILA</b> is a mobile Augmented Reality learning tool designed
    for classroom use in fisheries and marine science education. It transforms static
    tilapia anatomy content into interactive 3D experiences. Using AR, students can
    explore external, skeletal, and internal anatomy in real time.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
