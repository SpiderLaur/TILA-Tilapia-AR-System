  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Operculum (Gill Cover)
  description: 'Description: A hard, bony flap covering the gills on each side of
    the head. It opens and closes rhythmically to draw oxygen-rich water across the
    gills.


    Function: Protects the gills and regulates water flow over them
    for breathing.'
  voiceClip: {fileID: 8300000, guid: e236c2003ca022d409610d037a03d3aa, type: 3}
  linkedPopupModel: {fileID: 0}
