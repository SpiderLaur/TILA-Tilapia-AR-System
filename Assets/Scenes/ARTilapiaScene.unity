  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Vertebral Column
  description: 'Description: The vertebral column, or spine, is a chain of individual
    bony vertebrae running from just behind the skull to the tail, forming the main
    supporting axis of the fish''s body.


    Function: Supports the body''s structure
    while protecting the spinal cord, which passes through a canal formed by aligned
    openings in each vertebra.'
  voiceClip: {fileID: 8300000, guid: 6114f90614db7e445bd1d7856fe300c4, type: 3}
  linkedPopupModel: {fileID: 0}
