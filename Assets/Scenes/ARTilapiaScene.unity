  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Dorsal Fin
  description: 'Description: The dorsal fin runs along the midline of the fish''s
    back, supported by bony fin rays and spines that connect to the vertebral column
    through small anchoring bones called pterygiophores.


    Function: Acts like
    a keel to stabilize the fish and prevent rolling while swimming, and helps generate
    thrust and control sharp turns.'
  voiceClip: {fileID: 8300000, guid: 617597608aff92144a5cf953b621b72a, type: 3}
  linkedPopupModel: {fileID: 0}
