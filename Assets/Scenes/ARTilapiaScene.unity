  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Ribs
  description: 'Description: Fish ribs are slender curved bones attached to the vertebral
    arches, running along the trunk region of the body just beneath the vertebral
    column.


    Function: Together with the abdominal musculature, the ribs form
    a protective shield around internal organs and act as anchor points for muscles
    used in swimming.'
  voiceClip: {fileID: 8300000, guid: 0d3413a7ee33201499c787788c616734, type: 3}
  linkedPopupModel: {fileID: 0}
