  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Stomach
  description: 'Description: The stomach is a sac-like organ with a highly acidic
    environment, positioned centrally in the body cavity between the esophagus and
    intestines.


    Function: Stores food and begins digestion using acid and enzymes,
    particularly suited to breaking down algae and plant matter, before passing food
    to the intestines.'
  voiceClip: {fileID: 8300000, guid: 86fa043a494fb4e428130ce9b1cebc84, type: 3}
  linkedPopupModel: {fileID: 653725686}
