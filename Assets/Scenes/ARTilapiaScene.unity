  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Mouth
  description: 'Description: The terminal mouth sits at the front of the head, lined
    with fleshy lips and adapted for grazing on algae, plankton, and plant matter.
    This herbivorous diet is why tilapia have longer intestines than carnivorous
    fish.

    Function: Used for feeding, grasping and drawing in food from the
    water and surfaces.'
  voiceClip: {fileID: 8300000, guid: d04f5333f80fa834d92189f25ebb000f, type: 3}
  linkedPopupModel: {fileID: 0}
