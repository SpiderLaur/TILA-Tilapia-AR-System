  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Anal Fin
  description: 'Description: The anal fin sits on the underside of the body, closer
    to the tail than the pelvic fins, opposite the dorsal fin.


    Function: Works
    with the dorsal fin to prevent the body from rolling side to side, keeping the
    fish stable and on-course while swimming.'
  voiceClip: {fileID: 8300000, guid: ecaeae945a8213247b0d0bc29b2b9e1b, type: 3}
  linkedPopupModel: {fileID: 0}
