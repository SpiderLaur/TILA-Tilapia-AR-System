  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Caudal Fin
  description: 'Description: The caudal fin, or tail fin, sits at the very end of
    the body and is the only fin connected directly to the vertebral column through
    the caudal peduncle.


    Function: Generates the side-to-side sweeping motion
    that produces forward thrust, making it the fish''s primary source of propulsion
    through water.'
  voiceClip: {fileID: 8300000, guid: 765017d4d83f1e345b0ca285249f7731, type: 3}
  linkedPopupModel: {fileID: 0}
