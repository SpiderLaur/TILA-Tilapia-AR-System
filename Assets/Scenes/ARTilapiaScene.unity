  m_Script: {fileID: 11500000, guid: d393fe7be3c525143b8ecb4051bdff2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodyPartInfo
  partName: Genital Papilla (Urogenital Opening)
  description: 'Description: A small structure just in front of the anal fin. Males
    have two closely spaced openings, a larger anus and smaller urogenital pore,
    while females have three: anus, genital pore, and urinary pore, usually with
    a smaller papilla.


    Function: Outlet for waste, eggs, or sperm, and the
    main feature used to visually sex the fish.'
  voiceClip: {fileID: 8300000, guid: f998a4d575637fe4a90c8beee4817dc9, type: 3}
  linkedPopupModel: {fileID: 0}
